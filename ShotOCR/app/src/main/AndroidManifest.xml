<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShotOCR">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ShotOCR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name="org.caojun.shotocr.accounting.ui.ConfirmActivity"
            android:exported="false"
            android:label="@string/confirm_title"
            android:theme="@style/Theme.ShotOCR"
            tools:replace="android:exported,android:label,android:theme" />

        <activity
            android:name="org.caojun.shotocr.accounting.ui.BillListActivity"
            android:exported="false"
            android:label="@string/accounting_records"
            android:theme="@style/Theme.ShotOCR" />

        <activity
            android:name=".ClassificationManagementActivity"
            android:exported="false"
            android:label="@string/category_management_title"
            android:theme="@style/Theme.ShotOCR" />

        <activity
            android:name=".RecognitionSettingsActivity"
            android:exported="false"
            android:label="@string/recognition_settings"
            android:theme="@style/Theme.ShotOCR" />
    </application>

</manifest>
