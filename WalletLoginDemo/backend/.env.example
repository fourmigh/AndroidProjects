# 复制本文件为 .env 并填写真实值

# Google Pay & Wallet Console 中创建的 Issuer 账户 ID（纯数字）
ISSUER_ID=3388000000022000000

# Pass Class 后缀（自定义，建议小写字母 + 数字 + 下划线）
CLASS_SUFFIX=wallet_login_demo

# Google Cloud 服务账号 JSON 密钥路径（相对 backend 目录或绝对路径）
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# 后端监听端口
PORT=3000

# 动态码周期（毫秒），必须与 Pass 上的 periodMillis 一致
TOTP_PERIOD_MILLIS=30000

# 模拟模式：true 时无需 Google 凭据即可演示登录闭环
# 留空或 false 时自动检测：缺少 ISSUER_ID 或 service-account.json 时自动进入模拟模式
MOCK_WALLET=false

# NFC 读卡器共享口令（读卡器调 /api/nfc/challenge、/api/nfc/verify 时携带 X-Reader-Token）
# 仅当 NFC 配置中 readerAuth=true 时校验
NFC_READER_TOKEN=dev-reader-token
