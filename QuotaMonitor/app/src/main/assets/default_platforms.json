{
  "version": 1,
  "platforms": [
    {
      "id": "opencode",
      "name": "OpenCode Console",
      "url": "https://opencode.ai/console",
      "enabled": true,
      "loginKeywords": ["sign in", "log in"],
      "marketingKeywords": ["get started", "cheapest inference", "monthly subscription packages"],
      "pageMarkerRegex": "(\\d+(?:\\.\\d+)?)\\s*%\\s*used",
      "planNameRegex": "(?i)when\\s+your\\s+(.+?)\\s+usage\\s+resets",
      "planLineRegex": null,
      "remainKey": null,
      "endKey": null,
      "metrics": [
        {
          "label": "5-hour window",
          "mode": "percent_inline",
          "valueRegex": "(\\d+(?:\\.\\d+)?)\\s*%\\s*used",
          "resetRegex": "(?i)resets?\\s+in\\s+\\S[^,;.\\n]*",
          "lookAhead": 4
        },
        {
          "label": "Weekly",
          "mode": "percent_inline",
          "valueRegex": "(\\d+(?:\\.\\d+)?)\\s*%\\s*used",
          "resetRegex": "(?i)resets?\\s+in\\s+\\S[^,;.\\n]*",
          "lookAhead": 4
        },
        {
          "label": "Monthly",
          "mode": "percent_inline",
          "valueRegex": "(\\d+(?:\\.\\d+)?)\\s*%\\s*used",
          "resetRegex": "(?i)resets?\\s+in\\s+\\S[^,;.\\n]*",
          "lookAhead": 4
        }
      ]
    },
    {
      "id": "volc",
